# Composer installs from GitHub's archive of this repository: keep the PHP
# package lean by leaving the other languages, tests and CI out of it.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/node               export-ignore
/python             export-ignore
/php/tests          export-ignore
/php/examples       export-ignore
/phpunit.xml.dist   export-ignore
/test-vectors.json  export-ignore
/CONTRIBUTING.md    export-ignore
